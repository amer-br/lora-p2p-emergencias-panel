# Copia este archivo como .env y ajusta los valores.

# Django
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL
POSTGRES_HOST=db
POSTGRES_DB=panel_campus
POSTGRES_USER=panel
POSTGRES_PASSWORD=panel-secreto

# Cuenta inicial del responsable del campus (se crea si no existe)
RESPONSABLE_USUARIO=responsable
RESPONSABLE_PASSWORD=cambiame123
RESPONSABLE_EMAIL=

# Radio: simulador de radio (puerto 8080) o puente con la pasarela T-Beam (puerto 8081,
# ver puente_radio/README.md): RADIO_URL=ws://host.docker.internal:8081/ws
RADIO_URL=ws://host.docker.internal:8080/ws

# Sender_ID con el que el panel firma sus tramas (8 dígitos hex).
PANEL_SENDER_ID=0x0000CA0A
